    "pretest": "npm run typecheck && npm run build",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "google-auth-library": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
