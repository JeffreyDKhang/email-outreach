{
  "name": "email-outreach",
  "description": "Self-hosted email outreach for CSV contact lists, templates, segmentation and Gmail delivery.",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "tsc -p tsconfig.build.json",
